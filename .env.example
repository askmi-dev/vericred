# Copy to .env and adjust

# Port (default: 3100)
PORT=3100

# Enable synthetic test holders on startup (NEVER true in production)
# DEMO_MODE also disables holder proof-of-possession (unbound credentials!)
# If NODE_ENV=production is set, the gateway refuses to start with DEMO_MODE=true.
DEMO_MODE=false

# Show full emails in admin UI (default: masked for privacy)
PII_ADMIN_MODE=false

# Production: enforces Secure cookie flag
# NODE_ENV=production
