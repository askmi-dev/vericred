{
  "name": "vericred",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "stitch-out"
  ],
  "scripts": {
    "dev:api": "npm --workspace @vericred/api run dev",
    "dev:admin": "npm --workspace @vericred/admin-ui run dev",
    "dev:website": "npm --workspace stitch-site run dev",
    "build:shared": "npm --workspace @vericred/shared run build",
    "build:api": "npm --workspace @vericred/api run build",
    "build:admin": "npm --workspace @vericred/admin-ui run build",
    "build:website": "npm --workspace stitch-site run build",
    "build": "npm run build:shared && npm run build:api && npm run build:admin && npm run build:website",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:admin\" \"npm run dev:website\"",
    "test": "npm --workspace @vericred/api run test"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
