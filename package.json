{
  "name": "vericred",
  "version": "0.1.0",
  "description": "Lightweight OID4VCI issuer gateway — connect your database, issue W3C Verifiable Credentials",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:backend": "tsc -p tsconfig.json",
    "build:frontend": "npm --prefix stitch-out run build",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:connectors:live": "node scripts/connector-acceptance.mjs",
    "test:restore": "vitest run src/storage/__tests__/recovery.test.ts",
    "test:https": "node scripts/https-preflight.mjs",
    "test:wallet-contract": "vitest run tests/wallet-contract.test.ts",
    "walkthrough": "node scripts/local-walkthrough.mjs",
    "walkthrough:flow": "node scripts/local-wallet-flow.mjs"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^5.2.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^5.0.1"
  }
}
