---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Gateway overview">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-7">
        <div><p class="text-xs font-mono text-emerald-500 uppercase tracking-widest mb-2">VeriCred workspace</p><h2 class="text-3xl font-bold tracking-tight">Your credential gateway</h2><p class="text-slate-400 mt-2">See what is configured, follow a credential, and check what still needs real-world evidence.</p></div>
        <a class="primary-action shrink-0" href="/console/monitor">Open wallet walkthrough <span aria-hidden="true">→</span></a>
    </div>

    <section class="overview-card mb-6" aria-labelledby="runtime-heading">
        <div class="flex items-center justify-between gap-3 mb-4"><h3 id="runtime-heading" class="font-bold text-lg">Runtime readiness</h3><button id="refresh-readiness" class="secondary-action" type="button">Refresh</button></div>
        <p id="readiness-summary" class="text-sm text-slate-400" role="status">Reading this gateway’s configuration…</p>
        <div class="grid sm:grid-cols-3 gap-4 mt-5">
            <div class="runtime-field"><span>Issuer</span><strong id="runtime-issuer">Loading…</strong><small id="runtime-origin" class="break-all"></small></div>
            <div class="runtime-field"><span>Wallet profile</span><strong id="runtime-profile">Loading…</strong><small id="runtime-schema"></small></div>
            <div class="runtime-field"><span>Data source</span><strong id="runtime-source">Loading…</strong><small>Configuration alone does not prove a live connection.</small></div>
        </div>
        <details class="mt-5 border-t border-slate-800 pt-4"><summary class="cursor-pointer text-sm font-semibold">Inspect readiness and acceptance checks</summary><ul id="readiness-checks" class="grid md:grid-cols-2 gap-3 mt-4" aria-live="polite"><li class="text-sm text-slate-500">Loading checks…</li></ul></details>
        <p class="text-xs text-slate-500 mt-4">Automated protocol, local TLS and filesystem recovery tests are separate from independent wallet, public HTTPS, live database and Docker-volume acceptance.</p>
    </section>

    <section aria-label="Credential statistics" class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="overview-card"><p class="metric-label">Issued records</p><strong id="kpi-total" class="metric">—</strong></div>
        <div class="overview-card"><p class="metric-label">Active, unexpired</p><strong id="kpi-active" class="metric text-emerald-500">—</strong></div>
        <div class="overview-card"><p class="metric-label">Revoked</p><strong id="kpi-revoked" class="metric text-red-400">—</strong></div>
        <div class="overview-card"><p class="metric-label">Other / expiry unknown</p><strong id="kpi-other" class="metric">—</strong></div>
    </section>
    <p id="stats-status" role="status" class="text-xs text-slate-500 -mt-3 mb-6">Loading recorded credential state…</p>

    <section class="overview-card mb-6" aria-labelledby="flow-heading">
        <h3 id="flow-heading" class="text-lg font-bold">Follow the data</h3><p class="text-sm text-slate-400 mt-1">Every step has a visible outcome in the wallet walkthrough.</p>
        <ol class="grid md:grid-cols-4 gap-4 mt-5">
            <li class="flow-stop"><span class="step-number">1</span><h4>Source → issuer</h4><p>Select a holder. The gateway reads the source and applies the chosen schema mappings.</p><a href="/console/holders">Review holders →</a></li>
            <li class="flow-stop"><span class="step-number">2</span><h4>Issuer → wallet</h4><p>Create a one-time offer. The wallet proves its key and receives a signed credential.</p><a href="/console/monitor#issue">Create an offer →</a></li>
            <li class="flow-stop"><span class="step-number">3</span><h4>Wallet → verifier</h4><p>Request selected claims. The wallet asks for consent; VeriCred checks the presentation.</p><a href="/console/monitor#present">Request a presentation →</a></li>
            <li class="flow-stop"><span class="step-number">4</span><h4>Status → decision</h4><p>Review expiry and revocation. Revoke a test credential, then repeat the presentation.</p><a href="/console/monitor#records">Inspect credential records →</a></li>
        </ol>
    </section>

    <section class="overview-card" aria-labelledby="recent-heading">
        <div class="flex justify-between items-center gap-3 mb-4"><h3 id="recent-heading" class="text-lg font-bold">Recent credential records</h3><a href="/console/monitor#records" class="text-sm text-emerald-500 font-semibold">View all →</a></div>
        <div class="overflow-x-auto"><table class="w-full text-sm text-left"><thead><tr class="text-slate-500 border-b border-slate-800"><th scope="col" class="p-3">Issued</th><th scope="col" class="p-3">Subject</th><th scope="col" class="p-3">Type</th><th scope="col" class="p-3">Recorded status</th></tr></thead><tbody id="recent-records"><tr><td colspan="4" class="p-4 text-slate-500">Loading records…</td></tr></tbody></table></div>
    </section>

    <script>
        import { runtimeReadiness, statusLabels, readJson, element, formatTime } from '../../admin-runtime';
        const get = (id: string) => document.getElementById(id)!;
        function unavailable(message: string) {
            const row = element('tr'); const cell = element('td', message, 'p-4 text-slate-500'); cell.colSpan = 4; row.append(cell); get('recent-records').replaceChildren(row);
        }
        async function loadReadiness(refresh = false) {
            const button = get('refresh-readiness') as HTMLButtonElement;
            button.disabled = true;
            get('readiness-summary').textContent = 'Reading this gateway’s configuration…';
            try {
                const data = await runtimeReadiness(refresh);
                get('runtime-issuer').textContent = data.issuer.name;
                get('runtime-origin').textContent = data.issuer.url;
                get('runtime-profile').textContent = data.walletProfile === 'eudi-android' ? 'EUDI Android / shared miTch contract' : 'Custom / local integration';
                get('runtime-schema').textContent = data.credentials.map(c => c.type).join(', ');
                get('runtime-source').textContent = data.source.type + (data.source.configured ? ' · configured' : ' · needs configuration');
                get('readiness-summary').textContent = (data.configurationReady ? 'Configuration checks passed. ' : 'Some configuration needs attention. ') + 'Independent release acceptance remains unverified. Checked ' + formatTime(data.generatedAt) + '.';
                get('readiness-checks').replaceChildren(...data.checks.map(check => {
                    const item = element('li', '', 'rounded-xl border border-slate-800 p-3');
                    item.append(element('p', check.label + ' · ' + statusLabels[check.status], 'font-semibold text-sm'), element('p', check.detail, 'text-xs text-slate-500 mt-1'));
                    return item;
                }));
            } catch (error) {
                get('readiness-summary').textContent = error instanceof Error ? error.message : 'Readiness is unavailable.';
                get('readiness-checks').replaceChildren(element('li', 'Unable to read current state. Use Refresh to retry.', 'text-sm text-red-400'));
                for (const id of ['runtime-issuer', 'runtime-profile', 'runtime-source']) get(id).textContent = 'Unavailable';
            } finally { button.disabled = false; }
        }
        async function loadRecords() {
            try {
                const credentials = await readJson<any[]>('/admin/api/credentials');
                if (!Array.isArray(credentials)) throw new Error('Invalid credential records.');
                const active = credentials.filter(c => !c.revoked && Date.parse(c.expiresAt) > Date.now()).length;
                const revoked = credentials.filter(c => c.revoked).length;
                get('kpi-total').textContent = credentials.length.toLocaleString();
                get('kpi-active').textContent = active.toLocaleString();
                get('kpi-revoked').textContent = revoked.toLocaleString();
                get('kpi-other').textContent = (credentials.length - active - revoked).toLocaleString();
                get('stats-status').textContent = 'From the issued registry. Active means unexpired and not revoked; it does not confirm wallet acceptance.';
                if (!credentials.length) { unavailable('No credentials issued yet. Start the wallet walkthrough.'); return; }
                get('recent-records').replaceChildren(...credentials.slice(-5).reverse().map(c => {
                    const row = element('tr', '', 'border-b border-slate-800');
                    for (const text of [formatTime(c.issuedAt), c.holderEmail ?? 'Unknown', c.credentialType ?? 'Unknown (legacy)', c.revoked ? 'Revoked' : !c.expiresAt ? 'Expiry unknown' : Date.parse(c.expiresAt) <= Date.now() ? 'Expired' : 'Active']) row.append(element('td', String(text), 'p-3'));
                    return row;
                }));
            } catch (error) { get('stats-status').textContent = 'Credential statistics unavailable.'; unavailable(error instanceof Error ? error.message : 'Unable to load records.'); }
        }
        get('refresh-readiness').addEventListener('click', () => { void loadReadiness(true); void loadRecords(); });
        void loadReadiness(); void loadRecords();
    </script>
    <style>
        .overview-card { padding: 1.5rem; border: 1px solid #e2e8f0; border-radius: 1rem; background: rgba(255,255,255,.78); }
        .primary-action,.secondary-action { display:inline-flex;align-items:center;justify-content:center;gap:.6rem;padding:.7rem 1rem;border-radius:.75rem;font-weight:600;font-size:.875rem; }
        .primary-action { background:#047857;color:#fff; }.secondary-action {border:1px solid #cbd5e1;color:#334155;background:white;}
        button:disabled {opacity:.5;cursor:wait;} a:focus-visible,button:focus-visible,summary:focus-visible {outline:3px solid #10b981;outline-offset:3px;}
        .runtime-field {padding:1rem;border-radius:.75rem;background:#f8fafc;display:flex;flex-direction:column;gap:.35rem;}.runtime-field span,.metric-label {font-size:.75rem;color:#64748b;}.runtime-field small {color:#64748b;font-size:.75rem;}.runtime-field strong {font-size:.9rem;}.metric {display:block;font-size:2rem;margin-top:.5rem;}
        .flow-stop {border:1px solid #e2e8f0;border-radius:.75rem;padding:1rem;}.flow-stop h4 {font-weight:700;margin:.7rem 0 .5rem;}.flow-stop p {font-size:.85rem;color:#64748b;line-height:1.6;}.flow-stop a {display:block;margin-top:1rem;font-size:.8rem;font-weight:600;color:#047857;}.step-number {display:inline-flex;background:#d1fae5;color:#047857;border-radius:50%;width:1.8rem;height:1.8rem;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;}
    </style>
</AdminLayout>
