---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Schema Mapping">
    <!-- Page Header -->
    <div class="mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">Schema Mapping Workspace</h2>
        <p class="text-slate-400 text-sm md:text-base mt-1">Choose source fields for each credential template. Optional fields are included only when you map them.</p>
    </div>

    <!-- Action & Status Bar -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 mb-8 backdrop-blur-md gap-4">
        <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center">
            <div class="flex flex-col">
                <span class="text-[10px] font-mono font-bold text-slate-500 uppercase tracking-wider">Select Schema Template</span>
                <select id="select-schema-template" class="bg-slate-950 border border-slate-800 text-slate-200 rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:border-emerald-500 cursor-pointer min-w-[200px]">
                    <option value="">Loading templates...</option>
                </select>
            </div>
            <div class="flex flex-col">
                <span class="text-[10px] font-mono font-bold text-slate-500 uppercase tracking-wider">Mapping Status</span>
                <div class="flex items-center gap-2 mt-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span id="mapping-status-text" class="text-sm font-semibold text-emerald-400">Loading mappings…</span>
                </div>
            </div>
        </div>
        
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <button id="btn-test-mapping" class="w-full sm:w-auto px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white rounded-xl border border-slate-700/80 transition-all flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-wider">
                <span class="material-symbols-outlined text-sm">bug_report</span>
                <span>Check Mapping</span>
            </button>
            <button id="btn-save-schema" class="w-full sm:w-auto px-4 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl transition-all flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-wider shadow-[0_0_15px_rgba(16,185,129,0.2)] hover:shadow-[0_0_20px_rgba(16,185,129,0.3)]">
                <span class="material-symbols-outlined text-sm">save</span>
                <span>Save Schema</span>
            </button>
        </div>
    </div>

    <!-- Mapping Workspace Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 min-h-[550px] items-stretch">
        <!-- Source Fields (Left) -->
        <div class="lg:col-span-4 bg-slate-900/60 border border-slate-800/80 rounded-2xl flex flex-col overflow-hidden">
            <div class="p-4 border-b border-slate-800 bg-slate-950/40">
                <h3 class="text-sm font-bold text-white tracking-tight flex items-center gap-2">
                    <span class="material-symbols-outlined text-emerald-500 text-base">database</span>
                    <span>Connected Source Schema</span>
                </h3>
                <p class="text-[10px] font-mono text-slate-500 mt-1 uppercase tracking-wider">DataSource: <span id="source-type-label" class="text-slate-300">Loading…</span></p>
            </div>
            
            <div id="source-fields-container" class="flex-grow p-4 space-y-3 overflow-y-auto custom-scrollbar">
                <!-- Populated Dynamically -->
            </div>
        </div>

        <!-- Middle Connecting Lines SVG Canvas (Large Screens only) -->
        <div class="hidden lg:block lg:col-span-1 relative pointer-events-none">
            <svg class="absolute inset-0 w-full h-full" style="z-index: 10;">
                <path d="M 0 74 C 40 74, 10 74, 100% 74" fill="none" stroke="#10B981" stroke-width="2" class="drop-shadow-[0_0_4px_rgba(16,185,129,0.4)] opacity-40" />
                <path d="M 0 142 C 40 142, 10 142, 100% 142" fill="none" stroke="#10B981" stroke-width="2" class="drop-shadow-[0_0_4px_rgba(16,185,129,0.4)] opacity-40" />
                <path d="M 0 210 C 40 210, 10 210, 100% 210" fill="none" stroke="#10B981" stroke-width="2" class="drop-shadow-[0_0_4px_rgba(16,185,129,0.4)] opacity-40" />
            </svg>
        </div>

        <!-- Target claims (Middle-Right) -->
        <div class="lg:col-span-4 bg-slate-900/60 border border-slate-800/80 rounded-2xl flex flex-col overflow-hidden">
            <div class="p-4 border-b border-slate-800 bg-slate-950/40">
                <h3 class="text-sm font-bold text-white tracking-tight flex items-center gap-2">
                    <span class="material-symbols-outlined text-emerald-400 text-base">assignment_turned_in</span>
                    <span>Target VC claims Schema</span>
                </h3>
                <p class="text-[10px] font-mono text-slate-500 mt-1 uppercase tracking-wider">Format: <span id="target-format-label" class="text-emerald-500">SD-JWT-VC</span></p>
            </div>
            
            <div id="target-claims-container" class="flex-grow p-4 space-y-4 overflow-y-auto custom-scrollbar">
                <!-- Populated Dynamically -->
            </div>
        </div>

        <!-- Live Preview (Right Panel) -->
        <div class="lg:col-span-3 bg-slate-900/60 border border-slate-800/80 rounded-2xl flex flex-col overflow-hidden">
            <div class="p-4 border-b border-slate-800 bg-slate-950/40 flex justify-between items-center">
                <h3 class="text-sm font-bold text-white tracking-tight flex items-center gap-2">
                    <span class="material-symbols-outlined text-purple-400 text-base">code</span>
                    <span>Mapping Preview</span>
                </h3>
                <button id="btn-copy-preview" class="text-slate-400 hover:text-white transition-colors p-1" title="Copy JSON payload">
                    <span class="material-symbols-outlined text-lg">content_copy</span>
                </button>
            </div>
            
            <div class="flex-grow p-4 bg-slate-950/80 overflow-y-auto overflow-x-auto font-mono text-[11px] leading-relaxed text-slate-300 custom-scrollbar max-h-[420px]">
                <pre><code id="live-json-preview" class="text-slate-400">Loading preview...</code></pre>
            </div>

            <!-- Preview Bottom Status Bar -->
            <div class="p-3 bg-slate-950 border-t border-slate-800/80 flex flex-col sm:flex-row justify-between items-start sm:items-center text-[10px] font-mono gap-1">
                <span class="flex items-center gap-1 text-emerald-400">
                    <span class="material-symbols-outlined text-xs">verified</span>
                    <span>Illustrative input mapping</span>
                </span>
                <span class="text-slate-500 font-semibold tracking-wider">No credential issued</span>
            </div>
        </div>
    </div>

    <!-- Client Handlers -->
    <script>
        import { adminMutation, escapeHtml } from '../../admin-client';
        type Template = { id: string; displayName: string; requiredFields: string[]; optionalFields?: string[] };
        const select = document.getElementById('select-schema-template') as HTMLSelectElement;
        const status = document.getElementById('mapping-status-text')!;
        const source = document.getElementById('source-fields-container')!;
        const targets = document.getElementById('target-claims-container')!;
        const preview = document.getElementById('live-json-preview')!;
        const save = document.getElementById('btn-save-schema') as HTMLButtonElement;
        const check = document.getElementById('btn-test-mapping') as HTMLButtonElement;
        let templates: Template[] = [], columns: string[] = [];
        let mappings: Record<string, Record<string, string>> = {};
        let ready = false, saving = false;
        const template = () => templates.find(item => item.id === select.value);
        const active = () => mappings[select.value] ??= {};
        const fields = (item: Template) => [...new Set([...item.requiredFields, ...(item.optionalFields ?? [])])];
        const valid = (field: string) => columns.includes(active()[field]);
        const tell = (message: string) => { status.textContent = message; window.triggerToast?.(message); };
        async function read(url: string) {
            const response = await fetch(url, { cache: 'no-store', credentials: 'same-origin' });
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Unable to load workspace');
            return data;
        }
        function update() {
            const item = template(); if (!item) return;
            const count = item.requiredFields.filter(valid).length;
            const complete = count === item.requiredFields.length && !fields(item).some(field => active()[field] && !valid(field));
            status.textContent = count + ' / ' + item.requiredFields.length + ' required inputs mapped';
            status.className = 'text-sm font-semibold ' + (complete ? 'text-emerald-400' : 'text-amber-400');
            save.disabled = !ready || saving || !complete;
            preview.textContent = JSON.stringify({
                template: item.id,
                description: 'Illustrative input mapping. Issuance applies template transformations, signing and selective disclosure.',
                requiredInputs: Object.fromEntries(item.requiredFields.map(field => [field, active()[field] || '[unmapped]'])),
                optionalInputs: Object.fromEntries((item.optionalFields ?? []).filter(field => active()[field]).map(field => [field, active()[field]]))
            }, null, 2);
        }
        function render() {
            const item = template(); if (!item) return;
            document.getElementById('target-format-label')!.textContent = item.displayName;
            source.innerHTML = columns.length ? columns.map(column => '<div class="p-3 border border-slate-800 rounded-xl font-mono text-xs text-slate-200">' + escapeHtml(column) + '</div>').join('') : '<p class="text-sm text-amber-400">No fields found. Add a source record before mapping.</p>';
            targets.innerHTML = fields(item).map(field => {
                const required = item.requiredFields.includes(field), selected = active()[field] ?? '';
                const options = ['<option value="">' + (required ? 'Choose source field' : 'Not included') + '</option>', ...columns.map(column => '<option value="' + escapeHtml(column) + '"' + (column === selected ? ' selected' : '') + '>' + escapeHtml(column) + '</option>')];
                if (selected && !columns.includes(selected)) options.push('<option selected value="' + escapeHtml(selected) + '">Missing source: ' + escapeHtml(selected) + '</option>');
                return '<label class="block p-3 border border-slate-800 rounded-xl"><span class="font-mono text-xs text-white">' + escapeHtml(field) + '</span><span class="block text-xs text-slate-400 my-2">' + (required ? 'Required template input' : 'Optional — choose a source field to include') + '</span><select class="mapping w-full bg-slate-950 border border-slate-700 rounded p-2 text-xs" data-field="' + escapeHtml(field) + '">' + options.join('') + '</select></label>';
            }).join('');
            targets.querySelectorAll<HTMLSelectElement>('.mapping').forEach(control => control.addEventListener('change', () => {
                if (control.value) active()[control.dataset.field!] = control.value; else delete active()[control.dataset.field!];
                update();
            }));
            update();
        }
        async function load() {
            select.disabled = true; save.disabled = true; check.disabled = true;
            try {
                const [config, schema, registry] = await Promise.all([read('/admin/api/config'), read('/admin/api/source-schema'), read('/admin/templates')]);
                if (!Array.isArray(schema.columns) || !schema.columns.every((column: unknown) => typeof column === 'string')) throw new Error('Source returned an invalid schema');
                columns = schema.columns; templates = registry.templates;
                mappings = structuredClone(config.templateMappings ?? {});
                mappings[config.type] ??= { ...(config.fieldMappings ?? {}) };
                select.innerHTML = templates.map(item => '<option value="' + escapeHtml(item.id) + '">' + escapeHtml(item.displayName) + '</option>').join('');
                if (templates.some(item => item.id === config.type)) select.value = config.type;
                document.getElementById('source-type-label')!.textContent = config.dataSourceType;
                ready = true; select.disabled = false; check.disabled = false; render();
            } catch (error) {
                status.textContent = error instanceof Error ? error.message : 'Workspace unavailable';
                status.className = 'text-sm font-semibold text-red-400';
                source.textContent = 'Source schema unavailable. Check configuration and connectivity, then reload.';
                preview.textContent = 'Preview unavailable';
            }
        }
        select.addEventListener('change', render);
        check.addEventListener('click', () => {
            const item = template(); if (!item) return; update();
            const missing = item.requiredFields.filter(field => !valid(field));
            tell(missing.length ? 'Map existing source fields for: ' + missing.join(', ') : 'Required mappings are present. Verify holder values through an issuance test.');
        });
        save.addEventListener('click', async () => {
            const item = template(); if (!ready || saving || !item) return;
            const fieldMappings = Object.fromEntries(fields(item).filter(field => active()[field]).map(field => [field, active()[field]]));
            saving = true; save.disabled = true; select.disabled = true;
            try {
                const response = await adminMutation('/admin/api/save-mapping', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ templateId: item.id, fieldMappings }) });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'Could not save mappings');
                mappings[item.id] = fieldMappings; tell('Mappings saved for ' + item.displayName);
            } catch (error) { tell(error instanceof Error ? error.message : 'Could not save mappings'); }
            finally { saving = false; select.disabled = false; save.disabled = false; }
        });
        document.getElementById('btn-copy-preview')!.addEventListener('click', async () => {
            try { await navigator.clipboard.writeText(preview.textContent ?? ''); tell('Mapping preview copied'); }
            catch { tell('Could not copy preview'); }
        });
        void load();
    </script>
</AdminLayout>
